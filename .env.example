# Copy this file to .env for local development, and set the same keys as
# Environment Variables in the Vercel project for deploys (see README.md).

# --- Database (Prisma) ---------------------------------------------------
# Supabase Postgres connection string, using the CONNECTION POOLER (port
# 6543, pgbouncer) — not the direct connection (port 5432). Serverless
# functions open/close a connection per invocation, and the pooler is what
# keeps that from exhausting Supabase's connection limit.
# Find it in: Supabase dashboard → "Connect" button (top right) → "ORMs" tab
# → Prisma, or the connection-string tab → "Transaction" pooling mode.
# Replace [YOUR-PASSWORD] with your database password (Database → Settings
# → Database password).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Used only by `prisma migrate dev` / `migrate deploy` (schema migrations),
# never at app runtime. Prisma Migrate needs a non-transaction-pooled
# connection (prepared statements, DDL) — the transaction pooler above
# can't run migrations. Same host/user/password as DATABASE_URL, but the
# SESSION pooler port (5432) instead of the transaction one (6543), no
# `pgbouncer` flag. Find it in the same "Connect" modal as DATABASE_URL.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase (Auth + Storage only — product/category/etc. data goes ----
# --- through Prisma/DATABASE_URL, not through Supabase's own API) -------
# Public: safe to expose to the browser (used by the client-side Supabase
# SDK for admin login and image uploads to Storage).
# Find both in: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon public key]"

# Secret: server-only, bypasses Row Level Security. Required — used by
# src/lib/supabase/admin.ts to download comprobante-pago files server-side
# (src/lib/email.ts, to attach them to the owner notification email). The
# comprobantes-pago bucket's SELECT policy is restricted to `authenticated`
# users and email-sending code has no Supabase session, so this is the only
# way to read those files outside the admin's own logged-in browser. Find
# it in: Supabase dashboard → Project Settings → API → service_role key.
# Never prefix it with NEXT_PUBLIC_ or reference it from client components
# (the "server-only" package makes that a build error, as a backstop).
SUPABASE_SERVICE_ROLE_KEY="[service role secret key]"

# --- Site URL (used to build absolute links in transactional emails, -----
# --- e.g. the "subí tu comprobante" link — see src/lib/email.ts) --------
# No trailing slash. On Vercel, set to the production domain; locally
# defaults to http://localhost:3000 if unset.
# NEXT_PUBLIC_SITE_URL="https://sfpropadel.com.ar"

# --- Resend (order notification emails, src/lib/email.ts) ---------------
# Secret: server-only. Get one free at resend.com — see README.md for the
# exact signup + domain-verification steps.
RESEND_API_KEY="re_[your-api-key]"

# Optional. Defaults to "SF ProPadel <onboarding@resend.dev>" (Resend's
# shared sandbox sender — works immediately, but can only deliver to the
# email address the Resend account was signed up with). Once a real domain
# is verified in Resend, set this to a real address on that domain, e.g.
# "SF ProPadel <pedidos@sfpropadel.com.ar>" — see README.md.
# RESEND_FROM_EMAIL="SF ProPadel <pedidos@tudominio.com>"

# --- Pexels (scripts/seed-placeholder-images.ts only) --------------------
# Optional — only needed to run that one script, not by the app itself.
# Free key, no approval needed — see README.md ("Imágenes placeholder de
# demo") for the exact steps.
# PEXELS_API_KEY="[your-pexels-api-key]"

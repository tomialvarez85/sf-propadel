# Copy this file to .env for local development, and set the same keys as
# Environment Variables in the Vercel project for deploys (see README.md).

# --- Database (Prisma) ---------------------------------------------------
# Supabase Postgres connection string, using the CONNECTION POOLER (port
# 6543, pgbouncer) — not the direct connection (port 5432). Serverless
# functions open/close a connection per invocation, and the pooler is what
# keeps that from exhausting Supabase's connection limit.
# Find it in: Supabase dashboard → "Connect" button (top right) → "ORMs" tab
# → Prisma, or the connection-string tab → "Transaction" pooling mode.
# Replace [YOUR-PASSWORD] with your database password (Database → Settings
# → Database password).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Used only by `prisma migrate dev` / `migrate deploy` (schema migrations),
# never at app runtime. Prisma Migrate needs a non-transaction-pooled
# connection (prepared statements, DDL) — the transaction pooler above
# can't run migrations. Same host/user/password as DATABASE_URL, but the
# SESSION pooler port (5432) instead of the transaction one (6543), no
# `pgbouncer` flag. Find it in the same "Connect" modal as DATABASE_URL.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase (Auth + Storage only — product/category/etc. data goes ----
# --- through Prisma/DATABASE_URL, not through Supabase's own API) -------
# Public: safe to expose to the browser (used by the client-side Supabase
# SDK for admin login and image uploads to Storage).
# Find both in: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon public key]"

# Secret: server-only, bypasses Row Level Security. NOT currently used by
# any Server Action in this codebase — image uploads happen client-side
# under the logged-in admin's own session, governed by Storage RLS
# policies. Only add this if a future server-side Storage operation needs
# to bypass RLS (e.g. deleting objects on behalf of any admin). Never
# prefix it with NEXT_PUBLIC_ or reference it from client components.
# SUPABASE_SERVICE_ROLE_KEY="[service role secret key]"

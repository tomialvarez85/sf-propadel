// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String  @id @default(cuid())
  nombre      String
  slug        String  @unique
  descripcion String?
  orden       Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToSubcategory")

  products Product[]
}

model Brand {
  id     String  @id @default(cuid())
  nombre String
  slug   String  @unique

  products Product[]
}

enum Genero {
  HOMBRE
  MUJER
  UNISEX
}

enum Condicion {
  NUEVO
  USADO
}

model Product {
  id                 String    @id @default(cuid())
  nombre             String
  slug               String    @unique
  descripcion        String
  precio             Decimal   @db.Decimal(10, 2)
  precioAnterior     Decimal?  @db.Decimal(10, 2)
  stock              Int
  genero             Genero?
  condicion          Condicion @default(NUEVO)
  // Solo relevante cuando condicion=USADO — texto corto libre para describir
  // el estado del producto (ej. "Excelente estado, poco uso").
  estadoConservacion String?
  destacado          Boolean   @default(false)
  enOferta           Boolean   @default(false)
  activo             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
}

model ProductImage {
  id    String @id @default(cuid())
  url   String
  orden Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id    String @id @default(cuid())
  tipo  String
  valor String
  stock Int

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Curated by the owner in /admin/testimonios — no public submission form,
// admin-only content, not user-generated.
model Testimonial {
  id            String   @id @default(cuid())
  nombreCliente String
  comentario    String
  avatarUrl     String?
  orden         Int      @default(0)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// Singleton: siempre se lee/escribe la fila con id 1 (upsert desde la app).
model SiteSettings {
  id               Int     @id @default(1)
  whatsapp         String?
  instagram        String?
  email            String?
  // Separate from `email` above on purpose: `email` is the public contact
  // address shown on /contacto and the footer, emailPedidos is the internal
  // inbox that gets a notification on every new order — conflating them
  // would mean changing the public contact address silently rerouted order
  // notifications too.
  emailPedidos     String?
  direccion        String?
  horarioAtencion  String?
  textoEnvioGratis String?
  textoCuotas      String?
  textoNosotros    String?

  // Transferencia bancaria (pago manual, ver checkout / src/lib/email.ts).
  // Todos opcionales — no todos los negocios usan los mismos medios — y
  // cada uno se muestra en la confirmación de pedido y en el mail al
  // cliente solo si está cargado.
  alias   String?
  cbu     String?
  titular String?
  banco   String?
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  ENVIADO
  CANCELADO
}

model Order {
  id              String      @id @default(cuid())
  nombreCliente   String
  emailCliente    String
  telefonoCliente String
  total           Decimal     @db.Decimal(10, 2)
  estado          OrderStatus @default(PENDIENTE)
  createdAt       DateTime    @default(now())

  // Comprobante de transferencia subido por el cliente (bucket privado
  // "comprobantes-pago" — ver src/lib/supabase/storage.ts). comprobanteUrl
  // guarda el PATH dentro del bucket, no una URL pública: el bucket exige
  // sesión autenticada para leer, así que la vista siempre pide una signed
  // URL nueva en el momento (admin) en vez de confiar en un link fijo.
  comprobanteUrl      String?
  comprobanteSubidoEn DateTime?

  items OrderItem[]
}

// Every product-identifying field here is a snapshot taken at sale time
// (nombreProducto, variante, precioUnitario) — deliberately not a live read
// through `product`, so a later price change or product edit never rewrites
// order history. `productId` is optional with onDelete: SetNull for the same
// reason in the other direction: deleting a product must not be blocked by,
// or cascade into deleting, past orders that reference it.
model OrderItem {
  id             String  @id @default(cuid())
  nombreProducto String
  variante       String?
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model AdminUser {
  id             String @id @default(cuid())
  email          String @unique
  supabaseUserId String @unique
  nombre         String
  rol            String @default("admin")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String  @id @default(cuid())
  nombre      String
  slug        String  @unique
  descripcion String?
  imagen      String?
  orden       Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToSubcategory")

  products Product[]
}

model Brand {
  id     String  @id @default(cuid())
  nombre String
  slug   String  @unique
  logo   String?

  products Product[]
}

model Product {
  id             String   @id @default(cuid())
  nombre         String
  slug           String   @unique
  descripcion    String
  precio         Decimal  @db.Decimal(10, 2)
  precioAnterior Decimal? @db.Decimal(10, 2)
  stock          Int
  destacado      Boolean  @default(false)
  enOferta       Boolean  @default(false)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  images   ProductImage[]
  variants ProductVariant[]
}

model ProductImage {
  id    String @id @default(cuid())
  url   String
  orden Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id    String @id @default(cuid())
  tipo  String
  valor String
  stock Int

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Banner {
  id     String  @id @default(cuid())
  imagen String
  link   String?
  titulo String?
  orden  Int     @default(0)
  activo Boolean @default(true)
}

// Singleton: siempre se lee/escribe la fila con id 1 (upsert desde la app).
model SiteSettings {
  id               Int     @id @default(1)
  whatsapp         String?
  instagram        String?
  facebook         String?
  email            String?
  direccion        String?
  textoEnvioGratis String?
  textoCuotas      String?
  textoNosotros    String?
}

model AdminUser {
  id             String @id @default(cuid())
  email          String @unique
  supabaseUserId String @unique
  nombre         String
  rol            String @default("admin")
}
